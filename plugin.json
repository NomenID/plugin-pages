{
    "name": "Pages",
    "version": "1.0.0",
    "description": "In-site documentation: write guides inside {:sitename}, no separate docs site needed",
    "license": "GPL-3.0-only",
    "author": [
        "Yunyun"
    ],
    "requires": {
        "Nomen": ">=1.0"
    },
    "autoload": {
        "Nomen\\Plugin\\Pages\\": "src/"
    },
    "mounts": {
        "docs": {
            "path": "/w",
            "title": "站内文档",
            "description": "Write guides in {:sitename}, edited by admins in-site",
            "access": "public",
            "config": "base_path"
        }
    },
    "boot": [
        "Nomen\\Plugin\\Pages\\Plugin",
        "boot"
    ],
    "homepage": "https://github.com/NomenID/plugin-pages"
}
